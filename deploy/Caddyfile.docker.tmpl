__SITE_ADDRESS__ {
    encode zstd gzip

    @blocked path /.env* /app.env* /.git/* /data/*
    handle @blocked {
        respond 404
    }

    reverse_proxy cdk:8080 {
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
