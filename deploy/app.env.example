SERVER_HOST=127.0.0.1
SERVER_PORT=9080
SERVER_MODE=release
DB_PATH=/opt/cdk-recharge/data/cdk_recharge.db
WEB_DIR=/opt/cdk-recharge/web
JWT_SECRET=REPLACE_ME

# MarsWallex 等密钥的加密主密钥：base64 编码的 32 字节（openssl rand -base64 32）。
# 必填才能在后台保存 MarsWallex 凭证。丢失后已保存的密钥无法解密，只能在后台重新录入。
APP_MASTER_KEY=
INSTALL_MODE=wizard
# 可选：固定安装令牌；不设则启动日志打印随机 token
# SETUP_BOOTSTRAP_TOKEN=
# 公网域名安装：留空（仅靠 Setup Token）。仅本机装时可写 127.0.0.1,::1
SETUP_ALLOW_CIDRS=
# 反向代理的地址，逗号分隔，只能写 IP 或网段（如 172.16.0.0/12），不能写主机名。写错的项会被跳过并发 Telegram 告警，其余照常生效。
TRUSTED_PROXIES=127.0.0.1

# 浏览器跨域访问后台时允许的来源，逗号分隔；同域部署不用设。
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# 启动时自动建管理员（INSTALL_MODE=auto，或跳过安装向导直接给密码时用）。
# ADMIN_PASSWORD 至少 12 位、不能是常见弱口令、不能和用户名相同；不设则 wizard 模式不自动建号。
# 这也是忘记管理员密码时的找回办法：设上一个新的 ADMIN_USERNAME 和 ADMIN_PASSWORD 后重启，会再建一个管理员；
# 每次这样建号都会发 Telegram 告警并写一条审计（不含密码）。登录后记得删掉这两行。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 一键热更新（管理后台）。默认开启；设 0 关闭。Docker 部署同样支持（新版本写到数据卷的 runtime/）。
# 下载 GitHub Release 的 cdk-bundle-linux-amd64.tgz，校验 sha256 与 ed25519 签名、运行新程序自检、
# 备份程序/前端/数据库到 updates/backup-*，再热替换并 re-exec（不碰 app.env/data）。
# 新版本起不来时：/opt/cdk-recharge/cdk-recharge rollback && systemctl restart cdk-recharge
UPDATE_ENABLED=1
# 发布仓库，默认 hongheshan-svg/aisubproxy。不要指回上游 zovocard（签名不同，更新会被拒绝）。
# CDK_GITHUB_REPO=hongheshan-svg/aisubproxy
# 私有仓或提高 API 限额时可选
# GITHUB_TOKEN=
# 安装根目录（默认取可执行文件所在目录，生产一般为 /opt/cdk-recharge）
# CDK_INSTALL_DIR=/opt/cdk-recharge

# MarsWallex 自动付款用的浏览器路径。一般不用设：依次探测 /usr/bin/google-chrome-stable、/usr/bin/google-chrome、
# /usr/bin/chromium、/usr/bin/chromium-browser（Docker 镜像里已设为 /usr/bin/chromium）。
# 设置后只认这一个路径，文件不存在会直接报错，不再回落。
# 安装浏览器依赖：curl -fsSL https://raw.githubusercontent.com/hongheshan-svg/aisubproxy/master/deploy/install.sh | sudo bash -s -- --browser-deps
# CHROME_PATH=

# Telegram 告警。一般在后台「系统 → Telegram 告警」里配置（令牌加密保存，可发测试消息），后台配置优先；
# 后台没配时才用下面两个环境变量。私聊的 chat id 是你的 Telegram 数字 ID（可以问 @userinfobot）。
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# 服务器访问不了 api.telegram.org 时，给 Telegram 单独配代理（http://、https://、socks5://）；不影响其他接口的请求。
# TELEGRAM_PROXY=
