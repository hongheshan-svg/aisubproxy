[Unit]
Description=CDK Recharge System (gptcdk.ai)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cdk-recharge
EnvironmentFile=-/opt/cdk-recharge/app.env
ExecStart=/opt/cdk-recharge/cdk-recharge
Restart=on-failure
RestartSec=3
# 停止服务时程序先等在途付款单进入确认或结束（最多 3 分钟），再关闭 HTTP；这里多留一点余量，到点才 SIGKILL
TimeoutStopSec=240
LimitNOFILE=65535

# 不把密钥打进 journal 以外的地方；应用自身避免打印 secret
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
